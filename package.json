{
  "name": "taste-vault",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first vault for the interface design you've judged.",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"pnpm --filter @taste-vault/server dev\" \"pnpm --filter @taste-vault/web dev\"",
    "start": "pnpm --filter @taste-vault/web build && pnpm --filter @taste-vault/server start",
    "build": "pnpm --filter @taste-vault/web build",
    "preview": "pnpm --filter @taste-vault/web preview",
    "new-ref": "tsx scripts/new-ref.ts",
    "new": "tsx scripts/new-ref.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Mohammed Sadiq K",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.13.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
