# --- Private Vault -----------------------------------------------------------
# Everything the user saves is local and never committed. Only the authoring
# guide is tracked. See docs/adr/0001-references-degrade-gracefully.md.
references/*
!references/readme.md
!references/AGENTS.md

# --- Dependencies ----------------------------------------------------------------
node_modules/
.pnpm-store/

# --- Build output --------------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo

# --- Vite --------------------------------------------------------------------
.vite/
apps/web/dist/

# --- Caches / tooling --------------------------------------------------------
.cache/
.eslintcache
.turbo/
coverage/

# --- Environment / secrets -------------------------------------------------------
.env
.env.*
!.env.example

# --- Logs ------------------------------------------------------------------------
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editors / OS ----------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- AI assistant scratch --------------------------------------------------------
.scratch/
.codex/
.cursor/
.grok/

# --- Impeccable design tooling ------------------------------------------------
# config.json (shared detector settings) and design.json (DESIGN.md sidecar)
# are tracked; everything else under .impeccable/ is transient.
.impeccable/review/
.impeccable/hook.cache.json
.impeccable/questions/
.impeccable/config.local.json
